# ───────────────────────────── Aplicação ─────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3333
API_PORT=3333
LOG_LEVEL=info
TZ=America/Sao_Paulo

# Modo global das integrações: live | sandbox | disabled
# "disabled" faz o adapter falhar de forma explícita — nunca devolve resposta simulada.
INTEGRATION_MODE=disabled

# ───────────────────────────── Banco e cache ─────────────────────────────
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_rise?schema=public
REDIS_URL=redis://localhost:6379

# ───────────────────────────── Worker (apps/worker) ─────────────────────────────
# Jobs simultâneos por fila. O gargalo real é a sessão da WAHA, não a CPU.
WORKER_CONCURRENCY=5

# ───────────────────────────── Variante Vercel (apps/web sozinho + Trigger.dev) ─────────────────────────────
# Ver docs/07-deploy-vercel.md. Deixe NEXT_PUBLIC_API_URL ausente para ativar
# esta variante — com ela definida, o front usa a API Fastify completa.
# NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# ───────────────────────────── Segurança ─────────────────────────────
# Gerar com: openssl rand -base64 32
SESSION_SECRET=
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Chave AES-256-GCM (32 bytes em base64) usada para cifrar segredos no banco
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
WEBHOOK_RATE_LIMIT_MAX=600

# ───────────────────────────── WAHA (WhatsApp) ─────────────────────────────
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=loja-principal
# Token exigido no webhook e segredo do HMAC (X-Waha-Signature)
WAHA_WEBHOOK_TOKEN=
WAHA_WEBHOOK_HMAC_SECRET=
WAHA_TIMEOUT_MS=15000
WAHA_MAX_RETRIES=3

# ───────────────────────────── Nuvemshop ─────────────────────────────
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_API_URL=https://api.nuvemshop.com.br/v1
NUVEMSHOP_USER_AGENT=CRM Rise (contato@minhaloja.com.br)
NUVEMSHOP_SYNC_CRON=*/30 * * * *
# Minutos após os quais preço/estoque em cache são revalidados ao vivo
CATALOG_STALE_MINUTES=15

# ───────────────────────────── IA ─────────────────────────────
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.4
# Abaixo deste valor a conversa é transferida para um humano
AI_CONFIDENCE_THRESHOLD=0.7
AI_RETRIEVAL_TOP_K=6
AI_RETRIEVAL_MIN_SCORE=0.35
AI_MONTHLY_BUDGET_USD=200

# ───────────────────────────── Regras de atendimento ─────────────────────────────
STORE_NAME=Ateliê Marés
# Silêncio (minutos) após o qual a próxima mensagem abre uma nova conversa
INACTIVITY_WINDOW_MINUTES=360
AUTO_CLOSE_AFTER_MINUTES=1440
SLA_FIRST_REPLY_MINUTES=5
SLA_RESOLUTION_MINUTES=60

# ───────────────────────────── Armazenamento de mídia ─────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=crm-rise-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_TTL=300
MAX_UPLOAD_MB=16

# ───────────────────────────── LGPD ─────────────────────────────
MESSAGE_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1825
DATA_CONTROLLER_EMAIL=privacidade@minhaloja.com.br
